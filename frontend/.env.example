NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev-only UI (Prime preview button). Requires NODE_ENV=development AND this flag.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false

# Optional analytics (Plausible domain) — no-op when unset
NEXT_PUBLIC_ANALYTICS_ID=

# Optional error monitoring — no-op when unset
NEXT_PUBLIC_SENTRY_DSN=
