OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
JSEARCH_API_KEY=
# Get key: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch — subscribe (free tier), copy X-RapidAPI-Key
DATABASE_URL=sqlite:///./ats_agent.db
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads
APPLICATIONS_DIR=./applications
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_ENV=development
JWT_SECRET=change-me-in-production-use-long-random-string
# In production (APP_ENV=production), JWT_SECRET must be a strong random value — app refuses to start otherwise
JWT_EXPIRE_HOURS=168
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_SEARCH_INTERVAL_HOURS=4
DEFAULT_MIN_FIT_SCORE=75
DEFAULT_MAX_APPLICATIONS_PER_DAY=10
FREE_OPTIMIZATION_LIMIT=3

# Platform AI keys (server-side only — never exposed to users)
# One key powers all Free and Prime members

# Semantic job matching (set false in CI/constrained environments)
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
